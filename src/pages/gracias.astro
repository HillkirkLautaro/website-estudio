---
import BaseLayout from "../layouts/layout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="¡Gracias por tu mensaje! | Estudio Jurídico Alejandro Hillkirk" description="Mensaje enviado correctamente. Nos pondremos en contacto a la brevedad.">
  <section class="thank-you section">
    <div class="container">
      <div class="thank-you-card card animate-in" style="max-width: 560px; margin: 0 auto; text-align: center;">
        <div class="card-body">
          <div class="thank-you-icon" style="width: 64px; height: 64px; border-radius: var(--radius-full); background: rgb(37 211 102 / 0.15); color: var(--color-success); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2rem;">✓</div>
          <h1 style="font-size: clamp(1.75rem, 4vw, 2.25rem); margin: 0 0 1rem;">¡Gracias por tu mensaje!</h1>
          <p style="color: var(--color-text-muted); font-size: 1.1rem; margin: 0 0 2rem;">
            Nos pondremos en contacto contigo a la brevedad.
          </p>
          <Button variant="primary" size="base" asChild={false} href="/">
            Volver al inicio
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
