---
import BaseLayout from "../../layouts/layout.astro";
import Button from "../../components/ui/Button.astro";

const areas = [
  "Derecho Civil",
  "Derecho Penal",
  "Derecho Constitucional",
  "Teoría del Derecho",
  "Derecho Procesal",
  "Contratos y obligaciones"
];
---

<BaseLayout>
  <section class="service-page section">
    <div class="container">
      <div class="service-header animate-in">
        <h1 class="service-title">Clases Particulares para Estudiantes de Derecho</h1>
        <p class="service-lead">
          ¿Estás estudiando Derecho o una carrera afín? Como abogado con experiencia académica y profesional, ofrezco
          clases particulares personalizadas para ayudarte a entender los contenidos, preparar exámenes y avanzar con seguridad.
        </p>
      </div>

      <div class="service-grid" style="display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: start;">
        <div class="service-content">
          <h2 class="service-subtitle">Áreas en las que te puedo ayudar</h2>
          <ul class="service-list">
            {areas.map((area) => <li>{area}</li>)}
          </ul>

          <h2 class="service-subtitle" style="margin-top: 2.5rem;">Modalidad</h2>
          <p class="service-text">
            Las clases pueden ser virtuales o presenciales (en Zárate y alrededores), con horarios flexibles y enfoque
            práctico. También trabajo con grupos reducidos o acompañamiento individual intensivo según necesidad.
          </p>
        </div>

        <aside class="service-sidebar card">
          <div class="card-body">
            <h3 class="card-title">¿Interesado en una clase?</h3>
            <p class="card-text">Clases personalizadas, virtuales o presenciales, con horarios flexibles.</p>
            <Button variant="primary" size="base" asChild={false} href="/contacto" class="w-full" style="margin-top: 1rem;">
              Consultá por una clase
            </Button>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.service-title) {
    font-size: clamp(2rem, 5vw, 2.75rem);
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  :global(.service-lead) {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
    max-width: 680px;
  }

  :global(.service-subtitle) {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  :global(.service-list) {
    list-style: disc;
    margin: 0 0 1.5rem 1.5rem;
    padding: 0;
    color: var(--color-text);
    line-height: 1.8;
    font-size: 1.02rem;
  }

  :global(.service-list li) { margin-bottom: 0.5rem; }

  :global(.service-text) {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--color-text);
    margin: 0;
  }

  :global(.service-sidebar) { max-width: 300px; }

  @media (width <= 768px) {
    :global(.service-grid) { grid-template-columns: 1fr; }
    :global(.service-sidebar) { max-width: none; }
  }
</style>
