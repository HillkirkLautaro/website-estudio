---
import BaseLayout from "../layouts/layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Card from "../components/ui/Card.astro";

const imageModules = import.meta.glob<{ default: ImageMetadata }>("/src/assets/GaleriaEstudio/*.jpg", { eager: true });
const images = Object.values(imageModules).map((mod) => mod.default);

const imageModules2 = import.meta.glob<{ default: ImageMetadata }>("/src/assets/Diplomas/*.jpg", { eager: true });
const images2 = Object.values(imageModules2).map((mod) => mod.default);
---

<BaseLayout title="Estudio | Alejandro Hillkirk" description="Galería de fotos del estudio jurídico físico en Zárate. Conocé nuestras instalaciones.">
  <section class="page-header section animate-in">
    <div class="container">
      <h1 class="page-title">Nuestro Estudio</h1>
      <p class="page-subtitle">Conocé el espacio donde brindamos atención personalizada.</p>
    </div>
  </section>

  <!-- GALERÍA DEL ESTUDIO -->
  <section class="gallery section">
    <div class="container">
      <h2 class="section-title">Fotos del Estudio</h2>
      <div class="gallery-grid">
        {images.map((image, index) => (
          <Card class="gallery-item" style="display: contents; text-decoration: none; color: inherit;">
            <div class="gallery-image" style="padding-top: 75%; position: relative; overflow: hidden; border-radius: var(--radius);">
              <Image
                src={image}
                alt={`Foto del estudio ${index + 1}`}
                width={image.width}
                height={image.height}
                loading={index < 4 ? "eager" : "lazy"}
                class="gallery-img"
                style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;"
              />
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- GALERÍA DE CERTIFICADOS -->
  <section class="gallery section">
    <div class="container">
      <h2 class="section-title">Certificados y Diplomas</h2>
      <div class="gallery-grid">
        {images2.map((image2, index2) => (
          <a href={image2.src} target="_blank" rel="noopener noreferrer" class="cert-link">
            <Card class="gallery-item" style="display: contents; text-decoration: none; color: inherit;">
              <div class="gallery-image" style="padding-top: 130%; position: relative; overflow: hidden; border-radius: var(--radius);">
                <Image
                  src={image2}
                  alt={`Certificado ${index2 + 1}`}
                  width={image2.width}
                  height={image2.height}
                  loading="lazy"
                  class="gallery-img"
                  style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;"
                />
              </div>
            </Card>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.page-title) {
    font-size: clamp(2rem, 5vw, 2.75rem);
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  :global(.page-subtitle) {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  :global(.section-title) {
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    color: var(--color-text);
    margin: 0 0 1.5rem;
    text-align: center;
  }

  :global(.gallery-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  :global(.gallery-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.gallery-item):hover .gallery-img {
    transform: scale(1.05);
  }

  :global(.cert-link) { text-decoration: none; color: inherit; }

  @media (width <= 768px) {
    :global(.gallery-grid) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    :global(.gallery-image) { padding-top: 100%; }
  }
</style>
