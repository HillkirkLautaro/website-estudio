---
import BaseLayout from "../layouts/layout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout>
  <section class="contact-section section">
    <div class="container">
      <div class="section-header animate-in">
        <h1>Contacto</h1>
        <p>Para consultas o asesoramiento legal, completá el siguiente formulario o contactanos por nuestras redes sociales y correo electrónico.</p>
      </div>

      <div class="contact-grid" style="display: grid; grid-template-columns: 1fr 340px; gap: 3rem; align-items: start;">
        <!-- Formulario -->
        <form
          action="https://formsubmit.co/alejandrohk@gmail.com"
          method="POST"
          class="contact-form animate-in-delayed"
        >
          <!-- Anti-spam y control -->
          <input type="hidden" name="_captcha" value="true" />
          <input type="hidden" name="_next" value="https://estudiowebsite.netlify.app/gracias/" />

          <div class="form-group">
            <label for="nombre">Nombre</label>
            <input
              id="nombre"
              type="text"
              name="nombre"
              required
              maxlength="100"
              class="form-input"
              placeholder="Tu nombre completo"
            />
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input
              id="email"
              type="email"
              name="email"
              required
              maxlength="100"
              class="form-input"
              placeholder="tu@email.com"
            />
          </div>

          <div class="form-group">
            <label for="mensaje">Mensaje</label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="5"
              required
              maxlength="1000"
              class="form-input"
              placeholder="Cuéntanos cómo podemos ayudarte"
            ></textarea>
          </div>

          <Button type="submit" variant="primary" size="lg" class="w-full">
            Enviar mensaje
          </Button>
        </form>

        <!-- Contacto rápido -->
        <div class="quick-contact card">
          <div class="card-body">
            <h2 class="quick-contact-title">Contacto rápido</h2>
            <ul class="quick-list">
              <li class="quick-item">
                <span class="quick-label">WhatsApp</span>
                <a href="https://wa.me/+5493487230611" target="_blank" rel="noopener noreferrer" class="quick-value whatsapp">+54 9 3487 23-0611</a>
              </li>
              <li class="quick-item">
                <span class="quick-label">Instagram</span>
                <a href="https://www.instagram.com/alejandrohillkirk_abogado_/" target="_blank" rel="noopener noreferrer" class="quick-value instagram">@alejandrohillkirk_abogado_</a>
              </li>
              <li class="quick-item">
                <span class="quick-label">Facebook</span>
                <a href="https://www.facebook.com/HillkirkAlejandro" target="_blank" rel="noopener noreferrer" class="quick-value facebook">Alejandro Hillkirk Abogado</a>
              </li>
              <li class="quick-item">
                <span class="quick-label">Email</span>
                <a href="mailto:alejandrohk@gmail.com" class="quick-value email">alejandrohk@gmail.com</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.contact-section) { position: relative; }

  :global(.contact-form) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.form-group) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.form-group label) {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }

  :global(.form-input) {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 200ms ease, box-shadow 200ms ease;
    box-sizing: border-box;
  }

  :global(.form-input:focus) {
    border-color: var(--color-primary-accent);
    box-shadow: 0 0 0 4px rgb(0 123 255 / 0.12);
    outline: none;
  }

  :global(.form-input::placeholder) { color: var(--color-text-muted); opacity: 0.7; }

  :global(.w-full) { width: 100%; }

  /* Contacto rápido */
  :global(.quick-contact-title) {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 1rem;
  }

  :global(.quick-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.quick-item) { display: flex; flex-direction: column; gap: 0.25rem; }

  :global(.quick-label) {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  :global(.quick-value) {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color 200ms ease;
  }

  :global(.quick-value):hover { color: var(--color-primary-accent); text-decoration: underline; }

  :global(.quick-value.whatsapp) { color: var(--color-success); }
  :global(.quick-value.instagram) { color: #E1306C; }
  :global(.quick-value.facebook) { color: #1877F2; }
  :global(.quick-value.email) { color: var(--color-primary); }

  @media (width <= 768px) {
    :global(.contact-grid) { grid-template-columns: 1fr; }
  }
</style>
