---
// src/components/ui/Button.astro
// Botón reutilizable con variantes: primary | ghost | outline | success
// Tamaños: sm | base | lg
export interface Props {
  variant?: "primary" | "ghost" | "outline" | "success";
  size?: "sm" | "base" | "lg";
  type?: "button" | "submit" | "reset";
  href?: string;
  disabled?: boolean;
}

const {
  variant = "primary",
  size = "base",
  type = "button",
  href,
  disabled = false,
} = Astro.props;

const classes = [
  "btn",
  `btn-${variant}`,
  size === "sm" ? "btn-sm" : size === "lg" ? "btn-lg" : "",
];

const Tag = href ? "a" : "button";
---

<Tag
  {href}
  {type}
  {disabled}
  class={classes.filter(Boolean).join(" ")}
  aria-disabled={disabled ? "true" : undefined}
>
  <slot />
</Tag>

<style>
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    font-family: inherit;
    text-decoration: none;
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 200ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 200ms cubic-bezier(0.4, 0, 0.2, 1),
      color 200ms cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
  }

  :global(.btn):active { transform: scale(0.98); }

  :global(.btn):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    box-shadow: 0 0 0 4px rgb(255 204 0 / 0.15);
  }

  :global(.btn-primary) {
    background-color: var(--color-primary-accent);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-sm);
  }
  :global(.btn-primary):hover {
    background-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  :global(.btn-success) {
    background-color: var(--color-success);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-sm);
  }
  :global(.btn-success):hover {
    opacity: 0.92;
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  :global(.btn-ghost) {
    background-color: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  :global(.btn-ghost):hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-border-hover);
  }

  :global(.btn-outline) {
    background-color: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }
  :global(.btn-outline):hover {
    background-color: var(--color-primary);
    color: var(--color-text-inverse);
  }

  :global(.btn-sm) { padding: 0.5rem 1rem; font-size: 0.875rem; }
  :global(.btn-lg) { padding: 1rem 2rem; font-size: 1rem; }

  :global(.btn[disabled]),
  :global(.btn[aria-disabled="true"]) {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
  }
</style>
