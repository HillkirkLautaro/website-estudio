---
// src/components/WhatsAppButton.astro
// Botón flotante de WhatsApp: misma paleta verde, hover elevado y foco accesible.
import { Image } from "astro:assets";
import whatsappIcon from "../assets/icons/whatsapp.svg";
---

<a
  href="https://wa.me/+5493487230611"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
  class="whatsapp-float"
>
  <Image
    src={whatsappIcon}
    alt=""
    width={32}
    height={32}
    loading="eager"
  />
</a>

<style>
  :global(.whatsapp-float) {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 56px;
    height: 56px;
    background-color: var(--color-success);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
    z-index: 1000;
    text-decoration: none;
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 200ms cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    transform: translate(0, 30px);
    animation: slideUp 0.5s ease 0.2s forwards;
  }

  :global(.whatsapp-float):hover {
    transform: scale(1.1);
    box-shadow: 0 12px 24px -6px rgb(37 211 102 / 0.4);
  }

  :global(.whatsapp-float):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  :global(.whatsapp-float) img {
    width: 32px;
    height: 32px;
    display: block;
  }

  @keyframes slideUp {
    to {
      opacity: 1;
      transform: translate(0, 0);
    }
  }
</style>
